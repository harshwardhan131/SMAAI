# Copy this file to ".env" and fill in your own values. Never commit ".env" to Git.

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=smaai

# --- LLM (summaries, action items, Q&A) ---
# Default setup uses Groq (free API key from https://console.groq.com).
# Any OpenAI-compatible provider works: change BASE_URL and MODEL accordingly.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Speech-to-text ---
# tiny / base / small / medium  (bigger = more accurate but slower)
WHISPER_MODEL=base
